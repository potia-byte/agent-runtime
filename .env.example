# agent-runtime reads only these two optional variables (dashboard + demo).
# No secrets are required or used by this project.

# Directory that holds runtime.json / ledger.json (the "state directory").
AGENT_RUNTIME_DIR=./.agent-runtime

# Dashboard TCP port (binds to 127.0.0.1 only).
AGENT_RUNTIME_PORT=4877

# Optional: command the dashboard's "start" button launches (space-separated,
# first token is the executable). Leave empty to disable the button.
AGENT_RUNTIME_START_COMMAND=
